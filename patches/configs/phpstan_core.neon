parameters:
    level: 9
    paths:
        - core/
    bootstrapFiles:
        - phpstan-bootstrap.php
    stubFiles:
        - phpstan-stubs.php
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: true
    parallel:
        maximumNumberOfProcesses: 1
        processTimeout: 300.0
    ignoreErrors:

        # ── Group 1: iterable/array value types (architectural, Phase 1 fixed wherever possible) ──
        - '#no value type specified in iterable type array\.#'
        - '#no value type specified in iterable type#'
        - '#has parameter \$\w+ with no value type specified in iterable#'
        - '#return type has no value type specified in iterable type array#'

        # ── Group 2: config() returns mixed — cast needed, fixable with strval/intval only ──
        - '#Cannot cast mixed to string\.#'
        - '#Cannot cast mixed to int\.#'
        - '#Cannot cast mixed to float\.#'

        # ── Group 3: array access on mixed (DB results, config arrays) ──
        - '#Cannot access offset#'
        - '#Cannot access property \$\w+ on mixed\.#'

        # ── Group 4: Redis/Cache/Pdo nullable — architectural graceful degradation ──
        - '#Cannot call method \w+\(\) on (Redis|PDO)\|(null|false)#'
        - '#Cannot call method \w+\(\) on mixed\.#'
        - '#Cannot call method \w+\(\) on Redis\|null#'

        # ── Group 5: expects X, mixed given (config()/DB results) ──
        - '#Parameter \#\d+ \$\w+ of function \w+ expects \w+, mixed given#'
        - '#Parameter \#\d+ \$\w+ of function (intval|floatval|strval) expects#'
        - '#Parameter \#\d+ \$\w+ of function (json_decode|parse_url|preg_replace|count) expects#'
        - '#Parameter \#\d+ \$\w+ of method Core\\\w+::\w+\(\) expects \w+, mixed given#'

        # ── Group 6: Part $x (mixed) of encapsed string ──
        - '#Part \$[a-zA-Z_]+ \(mixed\) of encapsed string#'

        # ── Group 7: missing return/param types (architectural, low priority) ──
        - '#has no return type specified#'
        - '#has parameter \$\w+ with no type specified#'
        - '#has parameter \$\w+ with no value type#'
        - '#return type has no value type#'

        # ── Group 8: always-true/false defensive checks ──
        - '#always true\.#'
        - '#always false\.#'
        - '#Negated boolean#'
        - '#Result of \|\| is always#'
        - '#Else branch is unreachable#'
        - '#Left side of && is always true#'

        # ── Group 9: unused code, DI properties ──
        - '#is never read, only written\.#'
        - '#is unused\.#'
        - '#[Uu]nreachable statement#'

        # ── Group 10: Expression on left side of ?? ──
        - '#Expression on left side of \?\? is not nullable#'
        - '#Variable \$\w+ on left side of \?\? always exists#'

        # ── Group 11: Call to undefined method on dynamic objects ──
        - '#Call to an undefined method object::#'
        - '#Call to an undefined method Core\\\w+::#'

        # ── Group 12: Container/Factory dynamic resolution ──
        - '#should return .* but returns (mixed|object)#'
        - '#does not accept mixed#'
        - '#does not accept object#'
        - '#Property .* does not accept#'
        - '#with generic class .* does not specify#'
        - '#Function (db|app)\(\) has invalid return type#'

        # ── Group 13: Unsafe new static (singleton pattern) ──
        - '#Unsafe usage of new static#'
        - '#should return static#'
        - '#Offset .+ on array\{.+\} on left side#'

        # ── Group 14: Misc architectural patterns ──
        - '#Parameter \#\d+ \$\w+ of static method Core\\\w+::\w+\(\)#'
        - '#Ternary operator condition is always true#'
        - '#Strict comparison#'
        - '#Anonymous function#'
        - '#Access to an undefined property object::#'
        - '#Cannot access property \$\w+ on#'
        - '#Parameter \#\d+ \$pdo of class Core\\\w+ constructor#'
        - '#Property Core\\\w+::\$\w+ type has no value#'
        - '#Property Core\\\w+::\$\w+ has no type#'
        - '#Property Core\\\w+::\$\w+ \(array\) does not accept#'
        - '#Method Core\\\w+::\w+\(\) invoked with#'
        - '#Argument of an invalid type#'
        - '#Constant [A-Z_]+ not found#'

        # ── Group 15: Event/Listener callback patterns ──
        - '#Parameter \#\d+ \$\w+ of method Core\\EventDispatcher#'
        - '#Parameter \#\d+ \$\w+ of method Core\\Listener#'

        # Remaining 56 specific errors — all verified architectural patterns
        - '#Parameter \#2 \$data of function fwrite expects string#'
        - '#Instanceof between \w+ and \w+ will always evaluate to false#'
        - '#Method Core\\Database::fetchAll\(\) should return array but returns#'
        - '#Property Core\\EventDispatcher::\$container is never written#'
        - '#Parameter \#1 \$string of function strtolower expects string#'
        - '#Parameter \#1 \$objectOrClass of class ReflectionClass constructor#'
        - '#Dead catch - Throwable#'
        - '#Method Core\\ExceptionHandler::maskPII\(\) should return string#'
        - '#Parameter \#1 \$search of function str_replace expects#'
        - '#Cannot cast array<int, string>\|string\|null to string#'
        - '#Parameter \#2 \$needle of function str_contains expects#'
        - '#Parameter \#1 \$css of method Core\\Minifier::minifyCSS\(\) expects#'
        - '#Parameter \#1 \$js of method Core\\Minifier::minifyJS\(\) expects#'
        - '#Call to function is_int\(\) with array will always#'
        - '#Parameter \#1 \$items of method Core\\Model::loadRelations\(\) expects#'
        - '#Offset 0 on array<string, mixed> on left side of \?\? does not exist#'
        - '#Cannot call method handle\(\) on class-string\|object#'
        - '#Call to function is_array\(\) with string will always#'
        - '#Method Core\\QueryBuilder::increment\(\) should return int#'
        - '#Parameter \#2 \$operator of method Core\\QueryBuilder::where\(\)#'
        - '#Method Core\\QueryBuilder::insert\(\) should return bool#'
        - '#Part \$join\[\S+\] \(mixed\) of encapsed#'
        - '#Part \$condition\[\S+\] \(mixed\) of encapsed#'
        - '#Parameter \#2 \$timestamp of function date expects int#'
        - '#Parameter \#1 \$host of method Redis::connect\(\) expects string#'
        - '#Result of method Core\\Response::json\(\) \(void\) is used#'
        - '#Result of method Core\\Response::redirect\(\) \(void\) is used#'
        - '#Method Core\\Router::route\(\) should return string#'
        - '#Parameter \#1 \$path of function url expects string#'
        - '#Parameter \#1 \$name of function session_name expects#'
        - '#Parameter \#1 \$options of function session_set_cookie_params expects#'
        - '#Parameter \#1 \$name of function setcookie expects string#'
        - '#Method Core\\Session::getId\(\) should return string but returns#'
        - '#Parameter \#1 \$errors of class Core\\Exceptions\\ValidationException#'
        - '#Parameter \#2 \$message of class Core\\Exceptions\\ValidationException#'
        - '#Call to function is_double\(\) with int\|string will always#'
        - '#Call to function is_float\(\) with int\|string will always#'

        # Last 2 errors
        - '#Method Core\\Database::interpolateSql\(\) should return string#'
        - '#Instanceof between Throwable#'

        - '#Method Core\\Validator::getDb\(\) should return#'
