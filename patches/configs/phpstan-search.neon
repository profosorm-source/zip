# Honest, standalone gate for the Services/Search shard.
# This file intentionally has no baseline, ignoreErrors, or suppression rules.
parameters:
    level: 9
    paths:
        - app/Services/Search
    scanDirectories:
        - app
        - core
        - helpers
    bootstrapFiles:
        - phpstan-bootstrap.php
    treatPhpDocTypesAsCertain: true
    universalObjectCratesClasses:
        - stdClass
    parallel:
        maximumNumberOfProcesses: 1
        processTimeout: 300.0
