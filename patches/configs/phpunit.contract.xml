<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/8.5/phpunit.xsd"
         bootstrap="bootstrap/testing.php"
         executionOrder="default"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         verbose="true"
         colors="true">
    <testsuites>
        <testsuite name="External Provider Contract Tests">
            <directory>tests/Contract</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="NO_PROXY" value="8.8.8.8,127.0.0.1,localhost" force="true"/>
        <env name="no_proxy" value="8.8.8.8,127.0.0.1,localhost" force="true"/>
        <!-- مسیر state از محیط می‌آید (tests/Support/run-contract-suite.sh آن را
             نسبی به ریشهٔ پروژه تنظیم می‌کند). اگر تنظیم نشود، خود تست به
             sys_get_temp_dir()/chortke-provider-state برمی‌گردد. -->
        <env name="PROVIDER_CONTRACT_BASE_URL" value="http://8.8.8.8:8092" force="true"/>
        <ini name="display_errors" value="On"/>
        <ini name="display_startup_errors" value="On"/>
        <ini name="error_reporting" value="24575"/>
    </php>
</phpunit>
