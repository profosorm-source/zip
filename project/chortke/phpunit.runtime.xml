<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/8.5/phpunit.xsd"
         bootstrap="bootstrap/testing.php"
         executionOrder="default"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         verbose="true"
         colors="true">
    <testsuites>
        <testsuite name="Unit Tests">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration Tests">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <groups>
        <exclude>
            <group>architecture</group>
            <group>redis-unavailable</group>
        </exclude>
    </groups>

    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="testing-app-key-32-characters-long!!" force="true"/>
        <env name="SECURITY_API_TOKEN_SECRET" value="testing-security-token-secret-32!!" force="true"/>
        <ini name="display_errors" value="On"/>
        <ini name="display_startup_errors" value="On"/>
        <ini name="log_errors" value="On"/>
        <ini name="error_log" value="storage/logs/phpunit-error.log"/>
        <!-- E_ALL & ~E_DEPRECATED so PHP 8.4 deprecations from outdated
             vendor code (PHPUnit 8.5 setting session.use_only_cookies) don't
             pollute test output. Project code is checked against -1 in CI
             on a supported PHP version. -->
        <ini name="error_reporting" value="24575"/>
        <ini name="variables_order" value="EGPCS"/>
        <ini name="session.use_cookies" value="0"/>
    </php>
</phpunit>
