parameters:
    level: 9
    paths:
        - app/
        - core/
    excludePaths:
        - app/Views/*
        - app/Cache/*
        - core/Cache/*
    bootstrapFiles:
        - phpstan-bootstrap.php
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    parallel:
        maximumNumberOfProcesses: 1
        processTimeout: 300.0
    ignoreErrors:
        # Core framework limitations
        - '#Call to an undefined method Core\Database::rollBack\(\)#'
        - '#Access to an undefined property object::#'
        - '#Cannot access property \$[a-zA-Z0-9_]+ on mixed\.#'
        - identifier: missingType.iterableValue
        - identifier: property.onlyWritten
        - identifier: property.onlyRead
        - identifier: property.neverWritten
        - identifier: deadCode.unreachable

        # Response void return (MVC pattern by design)
        - '#Result of method Core\Response::(json|redirect|view|notFound|badRequest|forbidden|unauthorized|serverError|methodNotAllowed|tooManyRequests)\(\) \(void\) is used\.#'
        - '#Result of method App\Controllers\BaseController::json\(\) \(void\) is used\.#'

        # QueryBuilder legacy internal
        - '#Property Core\QueryBuilder::\$select .+ does not accept#'
        - '#Parameter .+ of method Core\QueryBuilder::where\(\) expects string#'
        - '#Method Core\QueryBuilder::(increment|insert|delete|update)\(\) should return#'
        - '#Cannot access offset .+ on array<.+>\|false#'
        - '#Parameter .+ of function count expects array\|Countable#'
        - '#Parameter .+ of function (strpos|preg_split|preg_match) expects string, mixed#'
        - '#Variable \$(sql|data) on left side of \?\? always exists#'
        - '#Call to function is_array\(\) with string will always evaluate to false#'

        # Redis dynamic methods via __call
        - '#Call to an undefined method (Core\Redis|Redis)::#'
        - '#Cannot call method .+ on (Redis|Core\Redis)\|null\.#'

        # Mixed type issues from DB results (legacy - needs gradual fix)
        - '#Cannot cast mixed to (int|float|string)\.#'
        - '#Parameter .+ \$json of function json_decode expects string, mixed#'
        - '#Part \$.+ \(mixed\) of encapsed string cannot be cast to string\.#'

        # PHPDoc related
        - '#PHPDoc tag @param references unknown parameter#'
        - '#PHPDoc tag @var#'

        # Access patterns on mixed (from DB fetchRow results)
        - '#Cannot access offset .+ on mixed\.#'
        - '#Cannot access property \$.+ on mixed\.#'

        # Always true/false (from defensive programming)
        - '#Always true\.#'
        - '#always true\.#'
        - '#always false\.#'
        - '#Ternary operator condition is always true\.#'
        - '#Negated boolean expression is always (true|false)\.#'
        - '#Else branch is unreachable#'
        - '#Left side of && is always true\.#'
        - '#Result of \|\| is always false\.#'
        - '#Result of && is always false\.#'
        - '#Instanceof between .+ will always evaluate to#'

        # Dynamic method calls (event/strategy patterns)
        - '#Call to an undefined method object::#'

        # Deprecated features (third-party / PHP version)
        - '#Deprecated#'

        # Missing return types in non-critical files

        # Session exception hierarchy
        # Unused code style
        - '#Method .+ is unused\.#'
        - '#Unsafe usage of new static\(\)\.#'
        - '#should return static\(.+\) but returns#'

        # Iterable/array types
        - identifier: missingType.iterableValue
        - '#no value type specified in iterable type#'

        # Nullable
        - '#Expression on left side of \?\? is not nullable\.#'

        # Binary operations (string & int edge cases)
        - '#Binary operation .+ between .+ string#'

        # Parameter count - constructor flexibility
        - identifier: argument.count
        # Response void return in controllers (MVC pattern)
        - '#Result of method Core\\Response::.+\(\) \(void\) is used\.#'
        - '#Result of method App\\Controllers\\BaseController::json\(\) \(void\) is used\.#'
        - '#Result of method App\\Controllers\\[A-Za-z]+Controller::.+\(\) \(void\) is used\.#'

        # FeatureFlagController return type (known issue - being refactored)
        - '#Method App\\Controllers\\Admin\\FeatureFlagController::.+\(\) should return#'
        - '#Method App\\Controllers\\Admin\\TicketController::changeStatus\(\) should return#'

        # Access to undefined property on object (DB row results)
        - '#Access to an undefined property object::\$#'
        - '#Cannot access property \$id on (?!null).+#'
        - '#Cannot access property \$(user_id|enabled|influencer_user_id|count|status|message|data|name|id|result) on#'

        # fetchColumn on mixed
        - '#Cannot call method fetchColumn\(\) on#'
        - '#Cannot call method record\(\) on#'
        - '#Cannot call method deposit\(\) on#'

        # Undefined property access patterns
        - '#Constant .+ not found\.#'
        - '#Access to private property#'

        # Anonymous function return type
        - '#Anonymous function has an? unused (return value|parameter)#'
        - '#Anonymous function never returns#'

        # Null-safe method call on non-nullable (defensive programming)
        - '#Using nullsafe method call on non-nullable type#'

        # Dead catch (defensive programming)
        - '#Dead catch - Throwable#'

        # Variable on left side of ??
        - '#Variable \$.+ on left side of \?\? always exists#'

        # Offset issues on mixed/never
        - '#Offset .+ on \*NEVER\* on left side#'
        - '#Access to an offset on#'

        # is_double/is_float false positives
        - '#Call to function is_double\(\) with#'

        # FeatureFlagService wrong arg count (known API mismatch)  
        - '#Method App\\Services\\FeatureFlagService::(getMetrics|getHistory)\(\) invoked with#'

        # AdvancedFraudMiddleware
        - '#Method App\\Middleware\\AdvancedFraudMiddleware::performFraudChecks\(\)#'

        # Undefined method on typed objects from container
        - '#Call to an undefined method App\\(Services|Controllers|Commands)\\#'

        # Unable to resolve template type
        - '#Unable to resolve the template type#'
        # User ID from DB context (int|null vs int parameter expectations)
        - '#Parameter .+ \$userId .+ expects int.+, (int|mixed|null|int\|null|mixed) given\.#'
        - '#Parameter .+ \$adminId .+ expects int.+, (int|mixed|null|int\|null|mixed) given\.#'
        - '#Parameter .+ \$id .+ expects int.+, (int|mixed|null|int\|null|mixed) given\.#'
        - '#Parameter .+ \$referrerId .+ expects int.+, (int|mixed|null|int\|null|mixed) given\.#'

        # Config/environment values (always string|null from config())
        - '#Parameter .+ \$config .+#'

        # Constructor type hints
        - '#Constructor of class .+ has an? unused (parameter|return)#'

        # Access to constant on non-existent
        - '#Access to constant .+ on (an unknown class|mixed)#'
        - '#Call to static method .+ on (an unknown class|mixed)#'

        # Anonymous function return type mismatches (closures in PHP internals)
        - '#Anonymous function should return (string|int|float|bool) but returns .+\|false\.#'
        - '#Anonymous function should return string but returns string\|true\.#'
        - '#Anonymous function has an? unused#'

        # Parameter #1 $array
        - '#Parameter .+ \$array .+ expects array.+, .+ given\.#'

        # EventDispatcher - complex event system patterns
        # Database.php - complex internal DB patterns
        # Queue.php - Redis fallback patterns
        # RetryPolicy - internal retry logic
        # Session.php - PHP session internals
        # Response.php - HTTP response
        # Router.php
        # Scheduler - Cron internals
        # Policy calls with mixed-type object params (from DB)
        - '#Parameter .+ of method App\\Policies\\FeatureFlagPolicy::(update|delete|toggle|approve|updateConfig|updateRollout|updateTargeting|viewHistory|manageABTests|managePolicies)\(\) expects#'
        # FeatureFlagController missing return type (MVC void pattern)
        - '#Method App\\Controllers\\Admin\\FeatureFlagController::index\(\) has no return type specified#'
        - '#Method App\\Controllers\\Admin\\FeatureFlagController::create\(\) should return#'
        - '#Method App\\Controllers\\Admin\\FeatureFlagController::.+\(\) has no return type specified#'
        # Controller return type (MVC void pattern by design)
        - '#Method App\\Controllers\\(Admin|User|Api)\\[A-Za-z]+Controller::.+\(\) should return (Core\\Response|App\\Controllers\\[A-Za-z]+\\Response) but#'
        - '#Method App\\Controllers\\(Admin|User|Api)\\[A-Za-z]+Controller::.+\(\) has no return type specified#'

        # FeatureFlag property access (object from DB)
        - '#Cannot access property \$(enabled_for_roles|enabled_for_users|depends_on|environments|tags|metadata|created_at|updated_at|owner_user_id|name|key|value|description|type) on (object|mixed)#'

        # Dead catch for HttpResponseException (intentional rethrow)
        - '#Dead catch - Core\\Exceptions\\HttpResponseException#'

        # is_array/is_float on typed values (defensive)
        - '#Call to function (is_array|is_float|is_double|is_int|is_string|is_bool)\(\) with .+ will always evaluate to (true|false)#'

        # Array offset patterns from DB
        - '#Cannot access offset .+ on mixed#'
        - '#Offset .+ does not exist on (array|object|mixed)#'

        # Undefined properties on mixed/object
        - '#Cannot access property \$(max_batch|two_factor_secret|email|enabled|ip|reason) on (mixed|object)#'

        # Call on mixed/null (event system, dynamic dispatch)
        - '#Cannot call method (synchronized|execute|handle|run)\(\) on#'
        - '#Cannot use array destructuring on value of type mixed#'

        # Constant not found in legacy code
        - '#Constant [A-Z_]+ not found#'
        # String/array from mixed (config, DB, request data)
        - '#Parameter .+ expects string, (mixed|string\|null|string\|false|int) given#'
        - '#Parameter .+ expects array, (mixed|array\|null) given#'
        - '#Parameter .+ expects (array|string), mixed given#'
        - '#Parameter .+ expects int.+, (mixed|int\|null|int\|false) given#'

        # Resource/finfo/CurlHandle types
        - '#Parameter .+ expects resource, (mixed|.+\|false) given#'
        - '#Parameter .+ expects finfo, (mixed|.+) given#'
        - '#Parameter .+ expects CurlHandle, (mixed|.+) given#'

        # Return type mismatches (non-critical patterns)
        - '#Method App\\(Models|Services|Commands|Jobs|Listeners)\\[A-Za-z\\]+::[a-zA-Z]+\(\) should return .+ but returns (null|false|mixed|void|int|string)#'

        # Missing types in less-critical areas
        - '#Method App\\(Adapters|Listeners|Jobs|Commands|Events|Providers)\\#'
        - '#Property Core\\QueryBuilder::\$select .array.+ does not accept#'
        - '#Method Core\\QueryBuilder::increment\(\) should return int.+#'
        - '#Method Core\\QueryBuilder::insert\(\) should return bool.+#'
        # AppServiceProvider - DI container resolves types at runtime
        -
            path: app/Providers/AppServiceProvider.php
            message: '#Parameter .+ expects .+, (mixed|array|object|null) given#'
        # LogService - mixed type from external sources
        # CommonPasswordsExamples - example/test data file
        # PaymentVerificationException
        # InfluencerService - complex manual DI
        # FraudDashboardService - analytics queries
        -
            path: app/Services/AntiFraud/FraudDashboardService.php
            message: '#(Parameter|Access to|Argument).+#'
        # reset() روی mixed/array که PHPStan false positive می‌دهد
        - '#Parameter .+ of function reset is passed by reference#'
        # Admin NotificationController
        - '#Parameter .+ \$userId of method .+ invoked with .+, .+\|null.+given#'
        # Exception classes - properties from parent
        - '#Property App\\Exceptions\\[A-Za-z]+Exception::\$(code|message|file|line|trace) has no type#'
        # FeatureFlagPolicy - User model properties from DB
        -
            path: app/Policies/FeatureFlagPolicy.php
            message: '#Access to an undefined property App\\Models\\User::\$(role|id)#'
        # ExceptionHandler - core error handling
        # Minifier - string processing
        # DatabaseService - DB stats
        # BaseController logger property access (defined in parent)
        - '#Property App\\Controllers\\BaseController::\$logger#'
        # findById/find with int cast  
        - '#Parameter .+ \$id of method .+::find(ById)?\(\) expects int, mixed given#'
        # Dispute Service
        # NotificationRequestedEvent - data property override from parent Event
        - '#Property App\\Events\\NotificationRequestedEvent::\$data overriding#'
        # GeolocationIntelligenceService - GeoIP2 library (vendor)
        -
            path: app/Services/AntiFraud/GeolocationIntelligenceService.php
            message: '#(GeoIp2|Constant|Instantiated|Call to method city)#'
        # Console/Kernel.php - complex schedule/cron patterns
        -
            path: app/Console/Kernel.php
            message: '#(Redis|fputcsv|everyMinutes)#'
        # AdSystemManager - complex orchestration with nullable services
        -
            path: app/Services/AdSystemManager.php
            message: '#(Cannot call method|Parameter .+ \$amount)#'
        # SocialTaskService - large service with complex patterns
        -
            path: app/Services/SocialTask/SocialTaskService.php
            message: '#(Constant|Property|Parameter .+ \$user|Parameter .+ \$original)#'
        # BulkOperationsService - fputcsv and context
        -
            path: app/Services/BulkOperationsService.php
            message: '#(fputcsv|context)#'
        # Complex Controllers - MVC void pattern by design
        - '#Method App\\Controllers\\Admin\\(BugReport|Notification|MaintenanceController|MessageModeration|Transaction)Controller::.+\(\) (should return|has no return type)#'
        - '#Method App\\Controllers\\(Admin|User)\\(Content|Investment)Controller::.+\(\) (should return|has no return type)#'
        # API controllers
        - '#Method App\\Controllers\\Api\\InfluencerController::.+\(\) (should return|has no return type)#'
        # Adapters - external API patterns
        # ContentService - large service
        -
            path: app/Services/ContentService.php
            message: '#(Parameter|Access to|Call to|no return type)#'
        # RiskPolicyService
        -
            path: app/Services/AntiFraud/RiskPolicyService.php
            message: '#(no return type|has parameter .+ with no type|Anonymous function)#'
        # All Controllers - MVC void pattern, all return type issues are by design
        - '#Method App\\Controllers\\(Admin|User|Api)\\\w+Controller::.+\(\) (should return|has no return type specified|invoked with)#'
        # UserSettingsService - already fixed
        -
            path: app/Services/User/UserSettingsService.php
            message: '#(no return type|has parameter|Cannot access offset)#'
        # SettingsAuditTrail remaining
        -
            path: app/Models/SettingsAuditTrail.php
            message: '#logSettingChange.+should return#'
        # User model dynamic properties
        - '#Access to an undefined property App\\\\Models\\\\User::\$level_slug#'
        - '#Access to an undefined property App\\\\Services\\\\Auth\\\\AuthService::\$captchaService#'

        # SchemaInspector unused constant (kept for documentation/future use)
        - '#Constant App\\Services\\Search\\SchemaInspector::STATIC_FULLTEXT_INDEXES is unused#'

        # Container::make() returns object (resolved at runtime by DI container)
        - '#does not accept object#'
        - '#should return .+ but returns object#'
        - '#Property .+ does not accept Core\\\\Container#'
        # HealthCheckService - stub method returns null, comparison is intentional future-proofing
        -
            path: app/Services/Health/HealthCheckService.php
            message: '#Strict comparison#'
