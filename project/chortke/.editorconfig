# EditorConfig — Chortke Project
# https://editorconfig.org
#
# هدف: یکپارچه‌سازی خط‌های جدید به LF در تمام پروژه
# هر ویرایشگری که EditorConfig ساپورت کنه، خودکار اعمال می‌کنه

root = true

# ── قوانین پیش‌فرض (برای همه فایل‌ها) ──────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# ── PHP ──────────────────────────────────────────────────────────────────
[*.php]
indent_size = 4

# ── JavaScript / TypeScript / Vue ────────────────────────────────────────
[*.{js,ts,vue,jsx,tsx}]
indent_size = 2

# ── CSS / SCSS / HTML ────────────────────────────────────────────────────
[*.{css,scss,html,blade.php}]
indent_size = 2

# ── JSON / YAML ──────────────────────────────────────────────────────────
[*.{json,yaml,yml}]
indent_size = 2

# ── Markdown (trailing whitespace معنی داره) ───────────────────────────
[*.md]
trim_trailing_whitespace = false

# ── Shell scripts ────────────────────────────────────────────────────────
[*.sh]
end_of_line = lf

# ── Config / Env ─────────────────────────────────────────────────────────
[.env*]
end_of_line = lf
