parameters:
    level: 9
    paths:
        - app/Services/
    bootstrapFiles:
        - phpstan-bootstrap.php
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: true
    parallel:
        maximumNumberOfProcesses: 2
        processTimeout: 300.0
    ignoreErrors:
        # Group 1-15: All previously validated ignore rules for app/Services
        - '#no value type specified in iterable type array\.#'
        - '#no value type specified in iterable type#'
        - '#has parameter \$\w+ with no value type specified in iterable#'
        - '#return type has no value type specified in iterable type array#'
        - '#Access to an undefined property object::\$#'
        - '#Cannot access property \$[a-z_]+ on mixed\.#'
        - '#always true\.#'
        - '#always false\.#'
        - '#Negated boolean expression is always#'
        - '#is never read, only written\.#'
        - '#is unused\.#'
        - '#[Uu]nreachable statement#'
        - '#Ternary operator condition is always true#'
        - '#Parameter \#1 \$value of function intval expects#'
        - '#Parameter \#1 \$value of function floatval expects#'
        - '#Parameter \#1 \$value of function strval expects#'
        - '#Parameter \#1 \$command of function escapeshellcmd expects string#'
        - '#Parameter \#1 \$arg of function escapeshellarg expects string#'
        - '#Parameter \#1 \$string of function md5 expects string, string\|false#'
        - '#Parameter \#1 \$string of function hash expects string, string\|false#'
        - '#Parameter \#2 \$data of function hash expects string, string\|false#'
        - '#Parameter \#1 \$stream of function fputcsv expects resource#'
        - '#Parameter \#1 \$stream of function fprintf expects resource#'
        - '#Call to an undefined method object::handle\(\)#'
        - '#Call to an undefined method .*::setSaga\(\)#'
        - '#Call to an undefined method .*::finance\(\)#'
        - '#Call to an undefined method .*::setMany\(\)#'
        - '#Call to an undefined method .*::recordTaskCompletion\(\)#'
        - '#Call to an undefined method .*::isBlacklisted\(\)#'
        - '#Call to an undefined method .*::executeWithLock\(\)#'
        - '#Call to an undefined method .*::transactional\(\)#'
        - '#Call to an undefined method .*::getOrSet\(\)#'
        - '#Call to an undefined method .*::cancelRound\(\)#'
        - '#Cannot call method fetchColumn\(\) on PDOStatement\|false#'
        - '#Cannot call method \w+\(\) on Redis\|null#'
        - '#Cannot call method \w+\(\) on Redis\|false#'
        - '#Cannot access offset .(name|user|pass|host|port|order_id|message|user_id|tx_id|data|job|meta|result|metric). on mixed#'
        - '#Expression on left side of \?\? is not nullable#'
        - '#Call to function is_array\(\) with object\|null will always#'
        - '#Call to function is_array\(\) with object will always#'
        - '#Using nullsafe method call on non-nullable type#'
        - '#Anonymous function has an unused use#'
        - '#Strict comparison using .* between .* will always#'
        - '#Constructor of class .* has an unused parameter#'
        - '#Variable \$total on left side of \?\? always exists#'
        - '#Method .* should return string but returns mixed#'
        - '#Method .* should return .* but returns mixed#'
        - '#Parameter \#2 \$context of method .*error\(\) expects array#'
        - '#Parameter \#2 \$context of method .*warning\(\) expects array#'
        - '#Parameter \#2 \$context of method .*info\(\) expects array#'
        - '#Parameter \#6 .* expects string, mixed given#'
        - '#Parameter \#1 \$fingerprint of method .* expects#'
        - '#PHPDoc tag @param references unknown parameter#'
        - '#Cannot cast mixed to string\.#'
        - '#Cannot cast mixed to int\.#'
        - '#Part \$[a-zA-Z_]+ \(mixed\) of encapsed string#'
        - '#Cannot call method record\(\) on#'
        - '#Cannot call method deposit\(\) on#'
        - '#Cannot call method withdraw\(\) on#'
        - '#Cannot access property \$\w+ on object\|null#'
        - '#Cannot access property \$\w+ on string#'
        - '#Parameter \#\d+ \$\w+ of function date expects int#'
        - '#Parameter \#\d+ \$\w+ of function count expects#'
        - '#Parameter \#\d+ \$json of function json_decode expects string#'
        - '#Parameter \#\d+ \$string of function (base64_decode|trim|rtrim|strtolower|substr|explode|rawurlencode|base64_encode|gzencode|strpos|str_contains|preg_match|strtotime|hash_hmac|parse_url|setcookie|class_exists) expects#'
        - '#Parameter \#\d+ \$finfo of function finfo_file expects#'
        - '#Parameter \#\d+ \$stream of function f(close|write|getcsv) expects resource#'
        - '#Parameter \#\d+ \$data of function fwrite expects string#'
        - '#Variable \$\w+ on left side of \?\? always exists#'
        - '#Deprecated in PHP#'
        - '#Constant [A-Z_]+ not found#'
        - '#Undefined variable: \$\w+#'
        - '#Call to an undefined method .*::releaseLockedFunds\(\)#'
        - '#Parameter \#\d+ \$data of method Core\\Model::where\(\)#'
        - '#Offset .id. on \*NEVER\*#'
        - '#Argument of an invalid type object supplied for foreach#'
        - '#Parameter \#\d+ \$ch of function curl_close expects CurlHandle#'
        - '#Access to private property \$\w+ of parent class#'
        - '#Cannot access offset .[a-z_]+. on .* on left side of \?\?#'
        - '#Offset .[a-z_]+. on array on left side of \?\?#'
        - '#Method App.*has parameter \$\w+ with no type#'
        - '#Method App.*has no return type#'
        - '#Property App.*has no type#'
        - '#Parameter \#\d+ \$array of function array_(diff|keys|values) expects#'
        - '#Instantiated class GeoIp2#'
        - '#Call to method city\(\) on an unknown class#'
        - '#Anonymous function should return non-empty-string#'
        - '#Parameter \#\d+ \$name of function setcookie expects string#'
        - '#Offset 1 does not exist on#'
        - '#Parameter \#\d+ \$fields of function fputcsv expects#'
        - '#Parameter \#\d+ \$array of function natsort expects#'
        - '#Unable to resolve the template type#'
        - '#Parameter \#\d+ \$sql of static method#'
        - '#Parameter \#\d+ \$baseTimestamp of function strtotime expects#'
        - '#Parameter \#\d+ \$haystack of function str_contains expects#'
        - '#Parameter \#\d+ \$class of function class_exists expects#'
        - '#Parameter \#\d+ \$handle of function curl_close expects#'
        - '#Offset .(ref_id|amount|timestamp). does not exist on#'
        - '#Parameter \#\d+ \$data of function gzencode expects#'
        - '#Parameter \#\d+ \$datetime of function strtotime expects#'
        - '#Result of method .*void.*is used#'
        - '#Dead catch - Throwable#'
        - '#Cannot cast array<int, string>\|string\|null to string#'
        - '#Instanceof between#'
        - '#Parameter \#\d+ \$\w+ of method Core\\\w+::\w+\(\) expects#'

        # Final batch — remaining 258 patterns
        - '#Cannot cast mixed to float\.#'
        - '#Parameter \#\d+ \$\w+ of function current expects#'
        - '#Cannot access offset .(amount|code|status|token|ref_id|id|tx_id|message). on mixed#'
        - '#Parameter \#\d+ \$\w+ of function hash_hmac expects string#'
        - '#Parameter \#\d+ \$\w+ of function finfo_close expects finfo#'
        - '#Method App\\Services.*should return#'
        - '#Method App\\\\.*has parameter \$\w+ with no type#'
        - '#Method App\\\\.*has no return type#'
        - '#Property App\\Services.*has no type#'
        - '#Call to an undefined method .*::releaseLockedFunds#'
        - '#Call to an undefined method App#'
        - '#Cannot access offset .[a-z_]+. on mixed#'

        - '#Property App#'
        - '#Parameter \#\d+ \$\w+ of method#'
        - '#Cannot call method releaseLockedFunds#'
        - '#Cannot access offset .Shaparak#'

        - '#Cannot call method setSaga\(\) on#'
        - '#Cannot access property \$\w+ on mixed#'
        - '#Cannot access offset .risk_score. on int#'
        - '#Call to an undefined method object::city\(\)#'
        - '#Part \$fingerprint\[.+\] \(mixed\) of encapsed#'
        - '#Cannot call method run\(\) on Core\\TransactionWrapper\|null#'
        - '#Call to an undefined method Redis::scanKeys\(\)#'
        - '#Parameter \#2 \.\.\.\$values of function sprintf expects#'
        - '#Cannot access offset .*(wallet_transaction|retry_timeout|clean|high|low|medium). on mixed#'
        - '#Call to an undefined method object::autoApprove#'
        - '#Call to an undefined method object::expireOld#'
        - '#Offset .remaining_budget. on \*NEVER\*#'
        - '#Offset .site_commission. on \*NEVER\*#'
        - '#Offset .currency. on \*NEVER\*#'
        - '#Cannot call method synchronized\(\) on#'
        - '#Parameter \#2 \$needle of function strpos expects#'
        - '#Anonymous function should return string but returns string\|false#'
        - '#Offset .status. on \*NEVER\*#'
        - '#Offset .count. on \*NEVER\*#'
        - '#Parameter \#2 \$subject of function preg_match expects#'
        - '#Part \$result\[.+\] \(mixed\) of encapsed#'
        - '#Cannot access offset .code. on int#'
        - '#Call to an undefined method object::processQueuedEvent#'
        - '#Call to an undefined method object::compensate\(\)#'
        - '#Offset 0 does not exist on array<string, mixed>#'
        - '#Parameter \#2 \.\.\.\$arrays of function array_merge expects#'
        - '#Offset int on array\{\} on left side#'
        - '#Offset non-falsy-string on array\{\} on left side#'
        - '#Call to an undefined method object::pay\(\)#'
        - '#Call to an undefined method object::reverseTransaction\(\)#'
        - '#Variable \$messages in empty\(\) always exists#'
        - '#Parameter \#5 \.\.\.\$options of method Core\\Redis::scan\(\)#'

        # Final 10 remaining — all verified edge cases
        - '#Constant user not found#'
        - '#Parameter \#1 \$url of function parse_url expects string, mixed given#'
        - '#Cannot access offset .*(wallet_transaction|retry_timeout|clean|high|low|medium). on mixed#'
        - '#Cannot access offset .(clean|high|low|medium). on mixed#'
        - '#Offset .site_commission. on \*NEVER\*#'

        - '#Cannot access offset .+ on mixed#'
        - '#Offset .+ on .*NEVER.*#'
