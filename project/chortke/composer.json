{
    "name": "chortke/platform",
    "description": "پلتفرم کسب درآمد آنلاین چرتکه",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "phpmailer/phpmailer": "^7.0",
        "ext-pdo": "*",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "ext-bcmath": "*",
        "chillerlan/php-qrcode": "^6.0",
        "geoip2/geoip2": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "core/",
            "App\\": "app/"
        },
        "files": [
            "core/Exceptions.php",
            "helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "require-dev": {
        "phpunit/phpunit": "8.*",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.11",
        "phpstan/phpstan-mockery": "^1.1"
    },
    "scripts": {
        "security-check": "composer audit",
        "analyze": "phpstan analyze -c phpstan_full.neon --memory-limit=2G",
        "test": "vendor/bin/phpunit",
        "ci": [
            "@security-check",
            "@test",
            "@analyze"
        ]
    }
}
