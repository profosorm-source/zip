; ==========================================
; Environment Configuration - Chortke Platform
; ==========================================
; Copy this file to .env and fill real values.
; DO NOT commit .env to version control.

; Application
APP_NAME=چرتکه
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
# Optional external asset/CDN base URL. Leave empty to use APP_URL / same-origin assets.
ASSET_URL=
CDN_URL=

; Encryption Keys (Generate: php -r "echo bin2hex(random_bytes(32));")
APP_KEY=YOUR_64_CHAR_HEX_KEY_HERE
SECURITY_API_TOKEN_SECRET=YOUR_64_CHAR_HEX_SECRET_HERE

; Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chortke
DB_USER=root
DB_PASS=
DB_ROOT_PASSWORD=

; Session
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTPONLY=true

; Currency Mode (toman | tether)
CURRENCY_MODE=toman

; Security
CSRF_TOKEN_LENGTH=32
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_DECAY_MINUTES=1

; Timezone
APP_TIMEZONE=Asia/Tehran

; Encryption migration flag.
ENCRYPTION_ALLOW_V1_READ=false

; Redis Cache
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=chortke
REDIS_TIMEOUT=1.5

; ═══════════════════════════════════════════════════════
; Sentry شخصی (داخلی) — Query Tracking & N+1 Detection
; ═══════════════════════════════════════════════════════
; پروژه از یک سیستم مانیتورینگ داخلی استفاده می‌کند (App\Services\Sentry\*)
; که داده‌ها را در دیتابیس خودتان ذخیره می‌کند (نه getesentry.com).
;
; DB_TRACK_QUERIES       : روشن/خاموش کردن tracking کوئری‌ها
; DB_TRACK_QUERIES_SAMPLE_RATE : درصد sampling (0.0 تا 1.0)
;
; محیط‌های پیشنهادی:
;   dev/staging  : DB_TRACK_QUERIES=true,  SAMPLE_RATE=1.0  (۱۰۰٪)
;   production   : DB_TRACK_QUERIES=true,  SAMPLE_RATE=0.1  (۱۰٪ — فشار کمتر)
DB_TRACK_QUERIES=true
DB_TRACK_QUERIES_SAMPLE_RATE=1.0

; Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@chortke.ir
MAIL_FROM_NAME="چرتکه"

; Feature Flags
FEATURE_LOTTERY_ENABLED=true
FEATURE_INVESTMENT_ENABLED=true
FEATURE_TASKS_ENABLED=true
FEATURE_REFERRAL_ENABLED=true
FEATURE_COUPONS_ENABLED=true
FEATURE_CRYPTO_ENABLED=true
FEATURE_CRYPTO_DEPOSIT_ENABLED=true
FEATURE_VITRINE_ENABLED=true
FEATURE_INVESTMENT_FEES_ENABLED=true
FEATURE_INVESTMENT_V2_CALCULATION_ENABLED=false
FEATURE_BETA_ENABLED=false
FEATURE_OAUTH_STRICT_IP_BINDING_ENABLED=false
; ═══════════════════════════════════════════════════════
; Webhook Security (REQUIRED in production)
; ═══════════════════════════════════════════════════════
WEBHOOK_SECRET=YOUR_64_CHAR_HEX_SECRET_HERE
WEBHOOK_SIGNATURE_HEADER=X-Signature

; ═══════════════════════════════════════════════════════
; File Storage (S3 / MinIO / Local)
; ═══════════════════════════════════════════════════════
FILESYSTEM_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=chortke-uploads
AWS_ENDPOINT=

# Content Security Policy static/CDN whitelist (comma-separated)
CSP_CDN_WHITELIST=
